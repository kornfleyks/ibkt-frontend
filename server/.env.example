MONDAY_API_TOKEN=your-monday-api-token
MONDAY_API_URL=https://api.monday.com/v2
# Comma-separated list of origins allowed to call this server.
ALLOWED_ORIGIN=http://localhost:5173,https://kornfleyks.github.io
PORT=4000
# Secret used to sign login session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-secret
# Shared code required to self-register a new account.
REGISTRATION_INVITE_CODE=your-invite-code
# Secret path segment for the Monday webhook endpoint (Users board Status /
# Role changes made directly on Monday). Optional until the server has a
# public URL; generate like JWT_SECRET but keep it under ~64 characters
# (Monday caps webhook URLs at 255). See README "Account state".
MONDAY_WEBHOOK_SECRET=your-webhook-secret

# Jotform (server/jotform/, see README "Jotform submissions"). A Read Access
# API key; the webhook secret is the last part of the webhook URL
# (generate like JWT_SECRET). The webhook also needs DATABASE_URL.
# JOTFORM_API_URL defaults to https://api.jotform.com (the account's region).
JOTFORM_API_KEY=your-jotform-api-key
JOTFORM_WEBHOOK_SECRET=your-jotform-webhook-secret
# JOTFORM_API_URL=https://api.jotform.com
